# Caddy hoitaa HTTPS:n (Let's Encrypt) automaattisesti.
# Vaihda domain omaksesi ja kopioi: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

coffee.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		-Server
	}

	reverse_proxy 127.0.0.1:8000
}
